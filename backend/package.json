{
  "name": "la-coccina-backend",
  "version": "1.0.0",
  "description": "Backend do La Coccina",
  "main": "server.js",
  "scripts": {
    "start": "npm run migrate && node server.js",
    "dev": "nodemon server.js",
    "stop": "powershell -ExecutionPolicy Bypass -File parar-servidor.ps1",
    "hash-password": "node scripts/hash-password.js",
    "prepare:presentation-orders": "node scripts/prepare-presentation-orders.js",
    "migrate": "node scripts/migrate.js",
