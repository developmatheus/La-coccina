# ============================================================================
# LA COCCINA — Configuração do servidor (copie para .env)
# ============================================================================

# Banco de dados SQLite — caminho relativo à pasta backend/
DB_PATH=./data/lacoccina.db

# Servidor
PORT=3001
NODE_ENV=production
SERVE_FRONTEND=true

# Admin (gere hash: npm run hash-password "sua_senha")
ADMIN_USERNAME=seu_usuario
ADMIN_PASSWORD=cole_hash_bcrypt_aqui

# Chave secreta — mínimo 32 caracteres aleatórios
SESSION_SECRET=troque_por_uma_string_longa_e_aleatoria_32chars

# Origens CORS extras (separe por vírgula) — inclua seu domínio de produção
# Exemplo futuro Cloudflare: CORS_ORIGINS=https://lacoccina.pages.dev
CORS_ORIGINS=
