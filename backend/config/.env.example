# ============================================================================
# LA COCCINA — Configuração do servidor (copie para .env)
# ============================================================================

# Banco de dados MySQL
DB_HOST=lhttps://la-coccina-production.up.railway.app
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lacoccina
# Use true em MySQL na nuvem (Render + TiDB, etc.)
DB_SSL=false

# Servidor
PORT=3001
NODE_ENV=production
SERVE_FRONTEND=true

# URL pública do site (com https) — usada no CORS
PUBLIC_URL=https://www.seudominio.com.br

# Admin (gere hash: node scripts/hash-password.js "sua_senha")
ADMIN_USERNAME=seu_usuario
ADMIN_PASSWORD=cole_hash_bcrypt_aqui

# Chave secreta — mínimo 32 caracteres aleatórios
SESSION_SECRET=troque_por_uma_string_longa_e_aleatoria_32chars

# Origens permitidas (separe por vírgula) — inclua seu domínio real
CORS_ORIGINS=la-coccina-production.up.railway.app